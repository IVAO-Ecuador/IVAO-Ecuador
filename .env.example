# .env.example
# Copia este archivo a .env.local y rellena los valores reales. NO subas .env.local al repositorio.

# NextAuth / OIDC (IVAO)
NEXTAUTH_SECRET=change_me_to_a_strong_random_string
IVAO_WELL_KNOWN=https://id.ivao.aero/.well-known/openid-configuration
IVAO_CLIENT_ID=your_ivao_client_id
IVAO_CLIENT_SECRET=your_ivao_client_secret
OAUTH_SCOPES=openid,email,profile

# App
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000

# MySQL (si usas persistencia)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ivao_db

# SMTP (Nodemailer) - opcional, para envío de correos
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="IVAO Ecuador <no-reply@example.com>"

# Otras variables posibles
# - Añade aquí cualquier otra variable que uses en `app/api/` o en scripts personalizados.

# Notas:
# - Usa .env.local en desarrollo (Next.js lo cargará automáticamente).
# - Nunca comitees secretos reales. Añade .env.local a .gitignore si no está ya.
# - En producción, configura las variables de entorno en tu plataforma (Vercel, Docker secrets, CI/CD secrets, etc.).
